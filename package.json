{
  "name": "prompt-guru",
  "productName": "Prompt-Guru",
  "version": "0.1.0",
  "description": "Local prompt optimizer for text/image/video; standby in system tray for one-click access",
  "main": "./dist/main/main.js",
  "author": "Dipankar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "cd renderer && vite",
    "dev:main": "tsc -p main/tsconfig.json && electron .",
    "bootstrap": "cd renderer && npm install && npm run build",
    "build:renderer": "cd renderer && npm run build",
    "build:main": "tsc -p main/tsconfig.json",
    "build": "npm run bootstrap && npm run build:main && electron-builder",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "electron": "^27.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "build": {
    "appId": "com.dipankar.prompt-guru",
    "productName": "Prompt-Guru",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "renderer/src/lib/adapters",
        "to": "adapters"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
